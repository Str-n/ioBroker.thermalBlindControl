              "step": "any"
            },
            {
              "attr": "gValue",
              "type": "number",
              "label": "Glazing g-value (0–1)",
              "default": 0.5,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "closedTransmission",
              "type": "number",
              "label": "Residual heat transmission when closed (0–1)",
              "default": 0.05,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "enabled",
              "type": "checkbox",
              "label": "Initially enabled",
              "default": true,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "autoMorningOpen",
