{
  "type": "tabs",
  "i18n": false,
  "items": {
    "_General": {
      "type": "panel",
      "label": "General",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "Runtime switches under global.* and windows.* persist across restarts. Initial switches below are used only when their states are created. Start with dry run and shadow mode; active thermal control additionally requires global.dryRun=false and global.enabled=true. Only blind command IDs are written.",
          "sm": 12
        },
        "enabled": {
          "type": "checkbox",
          "label": "Initially enabled",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "dryRun": {
          "type": "checkbox",
          "label": "Dry run: never send motor commands",
          "default": true,
          "xs": 12,
          "sm": 6
        },
        "thermalMode": {
          "type": "select",
          "label": "Thermal control mode",
          "default": "shadow",
          "xs": 12,
          "sm": 6,
          "options": [
            {
              "label": "off",
              "value": "off"
            },
            {
              "label": "shadow",
              "value": "shadow"
            },
            {
              "label": "active",
              "value": "active"
            }
          ]
        },
        "disabledToday": {
          "type": "checkbox",
          "label": "Initially disabled today",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "vacationMode": {
          "type": "checkbox",
          "label": "Initially in vacation mode",
          "default": false,
          "xs": 12,
          "sm": 6,
          "help": "Open in the morning, keep thermal protection active throughout the control day, and close in the evening. Vacation control ignores per-window enabled and morning-opening flags and does not require daily enrollment. Manual holds, daily manual opening limits, global controls and movement limits still apply. Thermal control requires active mode and valid forecast and room data; schedules remain available without them."
        },
        "latitude": {
          "type": "number",
          "label": "Latitude",
          "default": 50.47,
          "xs": 12,
          "sm": 6
        },
        "longitude": {
          "type": "number",
          "label": "Longitude",
          "default": 7.47,
          "xs": 12,
          "sm": 6
        },
        "timezone": {
          "type": "text",
          "label": "Building timezone (IANA)",
          "default": "Europe/Berlin",
          "xs": 12,
          "sm": 6
        },
        "startupDelaySeconds": {
          "type": "number",
          "label": "Startup Delay Seconds",
          "default": 30,
          "xs": 12,
          "sm": 6
        },
        "optimizationIntervalMinutes": {
          "type": "number",
          "label": "Optimization Interval Minutes",
          "default": 15,
          "xs": 12,
          "sm": 6
        },
        "minimumSolarPowerPerWindowW": {
          "type": "number",
          "label": "Minimum daylight per window (W)",
          "default": 0,
          "xs": 12,
          "sm": 6,
          "min": 0,
          "max": 10000,
          "help": "Reserve this much estimated unblocked solar power per window, even when the heat budget is exceeded. Limited by available sunlight. Zero disables the daylight minimum."
        },
        "minMovementIntervalMinutes": {
          "type": "number",
          "label": "Minimum time between automatic moves per blind (minutes)",
          "default": 15,
          "xs": 12,
          "sm": 6,
          "min": 15,
          "max": 1440,
          "help": "Applies to every automatic position change per blind, including morning and vacation schedules. 60 means at most one automatic move per hour. Thermal positions anticipate the full upcoming interval, including changes in solar exposure and daylight. The last-command timestamp survives restarts."
        },
        "allowedPositions": {
          "type": "chips",
          "label": "Allowed automatic positions (% open)",
          "default": [
            100,
            80,
            60,
            40,
            20,
            10,
            0
          ],
          "xs": 12,
          "sm": 12,
          "validator": "Array.isArray(data.allowedPositions) && data.allowedPositions.length >= 2 && data.allowedPositions.every(p => (typeof p === \"number\" || typeof p === \"string\" && p.trim() !== \"\") && Number.isFinite(Number(p)) && Number(p) >= 0 && Number(p) <= 100) && data.allowedPositions.some(p => Number(p) === 0) && data.allowedPositions.some(p => Number(p) === 100)",
          "validatorErrorText": "Enter percentages from 0 to 100, including 0 and 100.",
          "help": "Automatic targets round toward the next more open allowed position: 17 becomes 20, 20 stays 20, and 1 becomes 10 with the default list. Include 100 and 0; order does not matter. There is no minimum move size. Applies to thermal control, daylight and schedules. A manual opening ceiling uses the highest allowed position at or below that ceiling. Manual controls can use any position."
        },
        "respectManualPositionUntilEndOfDay": {
          "type": "checkbox",
          "label": "Keep manual closing as the maximum opening until midnight",
          "default": false,
          "xs": 12,
          "sm": 6,
          "help": "Optional, off by default. If a confirmed manual position is below the plan, remember it as the maximum opening for this blind until local midnight. Fully closing to 0 always establishes the limit. Automatic control can close further and reopen only up to this level. Any later manual move replaces an existing limit, including opening to 90 or 100. This overrides automatic daylight and scheduled opening; the timed manual pause and movement limits still apply. Survives restarts."
        }
      }
    },
    "_Rooms": {
      "type": "panel",
      "label": "Rooms & heating",
      "items": {
        "rooms": {
          "type": "accordion",
          "titleAttr": "name",
          "noDelete": false,
          "sm": 12,
          "onChange": {
            "calculateFunc": "for (const room of data.rooms || []) { (function normalizeDottedFields(data, property, keys) {\n    let changed = false;\n    for (const key of keys) {\n        const attr = `${property}.${key}`;\n        if (!Object.prototype.hasOwnProperty.call(data, attr))\n            continue;\n        if (!changed)\n            data[property] = { ...data[property] };\n        data[property][key] = data[attr];\n        delete data[attr];\n        changed = true;\n    }\n    return changed;\n})(room, 'heating', [\"type\",\"setpointId\",\"demandId\",\"valvePositionId\",\"nominalPowerW\",\"residualTimeHours\"]); } return data.rooms;"
          },
          "items": [
            {
              "attr": "id",
              "type": "text",
              "label": "Stable ID (letters, numbers, _ or -)",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "name",
              "type": "text",
              "label": "Display name",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "temperatureSensorId",
              "type": "objectId",
              "label": "Measured room temperature state (°C)",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "targetTemperatureC",
              "type": "number",
              "label": "Target temperature (°C)",
              "default": 21,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "heatLossWK",
              "type": "number",
              "label": "Heat loss coefficient (W/K)",
              "default": 80,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "floorAreaM2",
              "type": "number",
              "label": "Floor area (m²)",
              "default": 25,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "construction",
              "type": "select",
              "label": "Effective construction mass",
              "default": "medium",
              "xs": 12,
              "sm": 6,
              "options": [
                {
                  "label": "veryLight",
                  "value": "veryLight"
                },
                {
                  "label": "light",
                  "value": "light"
                },
                {
                  "label": "medium",
                  "value": "medium"
                },
                {
                  "label": "heavy",
                  "value": "heavy"
                },
                {
                  "label": "veryHeavy",
                  "value": "veryHeavy"
                }
              ]
            },
            {
              "attr": "internalGainsW",
              "type": "number",
              "label": "Constant internal gains (W)",
              "default": 0,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "heating.type",
              "type": "select",
              "label": "Heating system",
              "default": "none",
              "xs": 12,
              "sm": 6,
              "options": [
                {
                  "label": "none",
                  "value": "none"
                },
                {
                  "label": "radiator",
                  "value": "radiator"
                },
                {
                  "label": "underfloor",
                  "value": "underfloor"
                }
              ]
            },
            {
              "attr": "heating.setpointId",
              "type": "objectId",
              "label": "Read-only heating setpoint state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.demandId",
              "type": "objectId",
              "label": "Read-only heating demand state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.valvePositionId",
              "type": "objectId",
              "label": "Read-only valve position state (%)",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.nominalPowerW",
              "type": "number",
              "label": "Heuristic nominal heating power (W)",
              "default": 1000,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "heating.residualTimeHours",
              "type": "number",
              "label": "Underfloor residual time constant (hours)",
              "default": 3,
              "xs": 12,
              "sm": 6
            }
          ]
        },
        "centralHeating.flowTemperatureId": {
          "type": "objectId",
          "label": "Read-only central supply temperature (°C)",
          "default": "",
          "xs": 12,
          "sm": 12
        },
        "centralHeating.returnTemperatureId": {
          "type": "objectId",
          "label": "Read-only central return temperature (°C)",
          "default": "",
          "xs": 12,
          "sm": 12
        }
      }
    },
    "_Windows": {
      "type": "panel",
      "label": "Windows",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "All positions and diagnostics: 100 = fully open, 0 = fully closed. Configure raw device endpoints explicitly; the adapter converts them to this convention. Shared actual/target IDs are supported for one window. Use distinct actuator IDs for different windows.",
          "sm": 12
        },
        "windows": {
          "type": "accordion",
          "titleAttr": "name",
          "noDelete": false,
          "sm": 12,
          "items": [
            {
              "attr": "id",
              "type": "text",
              "label": "Stable ID (letters, numbers, _ or -)",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "name",
              "type": "text",
              "label": "Display name",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "roomId",
              "type": "text",
              "label": "Room ID",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "azimuthDeg",
              "type": "number",
              "label": "Compass azimuth (north 0°, east 90°)",
              "default": 180,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "tiltDeg",
              "type": "number",
              "label": "Window tilt (vertical = 90°)",
              "default": 90,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "glassAreaM2",
              "type": "number",
              "label": "Glazing area (m²)",
              "default": 3,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "gValue",
              "type": "number",
              "label": "Glazing g-value (0–1)",
              "default": 0.5,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "closedTransmission",
              "type": "number",
              "label": "Residual heat transmission when closed (0–1)",
              "default": 0.05,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "enabled",
              "type": "checkbox",
              "label": "Initially enabled",
              "default": true,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "autoMorningOpen",
              "type": "checkbox",
              "label": "Initially allow morning opening",
              "default": true,
              "xs": 12,
              "sm": 6,
              "help": "Normal mode only. If off, wait for a confirmed external opening before starting thermal control for this blind today. Vacation mode ignores this flag and runs its morning schedule and daytime thermal protection."
            },
            {
              "attr": "positionStateId",
              "type": "objectId",
              "label": "Actual motor position state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "positionCommandId",
              "type": "objectId",
              "label": "Motor target state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "movementStateId",
              "type": "objectId",
              "label": "Optional moving indicator state (boolean / 0–1)",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "deviceOpenValue",
              "type": "number",
              "label": "Device value when fully OPEN",
              "default": 100,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "deviceClosedValue",
              "type": "number",
              "label": "Device value when fully CLOSED",
              "default": 0,
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "travelSeconds",
              "type": "number",
              "label": "Motor feedback recognition timeout (seconds)",
              "default": 120,
              "xs": 12,
              "sm": 6
            }
          ]
        }
      }
    },
    "_Schedule": {
      "type": "panel",
      "label": "Schedules & manual control",
      "items": {
