          "default": 8,
          "xs": 12,
          "sm": 6
        },
        "limitSmoothingMinutes": {
          "type": "number",
          "label": "Limit Smoothing Minutes",
          "default": 60,
          "xs": 12,
          "sm": 6
        }
      }
    }
  }
}
