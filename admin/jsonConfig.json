              "type": "number",
              "label": "Floor area (m²)",
              "default": 25,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "construction",
              "type": "select",
              "label": "Effective construction mass",
              "default": "medium",
              "xs": 12,
              "sm": 6,
              "options": [
                {
                  "label": "veryLight",
                  "value": "veryLight"
                },
                {
                  "label": "light",
                  "value": "light"
                },
                {
                  "label": "medium",
                  "value": "medium"
                },
                {
                  "label": "heavy",
                  "value": "heavy"
                },
                {
                  "label": "veryHeavy",
                  "value": "veryHeavy"
                }
              ]
            },
            {
              "attr": "internalGainsW",
              "type": "number",
              "label": "Constant internal gains (W)",
              "default": 0,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "heating.type",
              "type": "select",
              "label": "Heating system",
              "default": "none",
              "xs": 12,
              "sm": 6,
              "options": [
                {
                  "label": "none",
                  "value": "none"
                },
                {
                  "label": "radiator",
                  "value": "radiator"
                },
                {
                  "label": "underfloor",
                  "value": "underfloor"
                }
              ]
            },
            {
              "attr": "heating.setpointId",
              "type": "objectId",
              "label": "Read-only heating setpoint state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.demandId",
              "type": "objectId",
              "label": "Read-only heating demand state",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.valvePositionId",
              "type": "objectId",
              "label": "Read-only valve position state (%)",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "heating.nominalPowerW",
              "type": "number",
              "label": "Heuristic nominal heating power (W)",
              "default": 1000,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "heating.residualTimeHours",
              "type": "number",
              "label": "Underfloor residual time constant (hours)",
              "default": 3,
              "xs": 12,
              "sm": 6,
              "step": "any"
            }
          ]
        },
        "centralHeating.flowTemperatureId": {
          "type": "objectId",
          "label": "Read-only central supply temperature (°C)",
          "default": "",
          "xs": 12,
          "sm": 12
        },
        "centralHeating.returnTemperatureId": {
          "type": "objectId",
          "label": "Read-only central return temperature (°C)",
          "default": "",
          "xs": 12,
          "sm": 12
        }
      }
    },
    "_Windows": {
      "type": "panel",
      "label": "Windows",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "All positions and diagnostics: 100 = fully open, 0 = fully closed. Configure raw device endpoints explicitly; the adapter converts them to this convention. Shared actual/target IDs are supported for one window. Use distinct actuator IDs for different windows.",
          "sm": 12
        },
        "windows": {
          "type": "accordion",
          "titleAttr": "name",
          "noDelete": false,
          "noAdd": false,
          "sm": 12,
          "items": [
            {
              "attr": "id",
              "type": "text",
              "label": "Stable ID (letters, numbers, _ or -)",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "name",
              "type": "text",
              "label": "Display name",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "roomId",
              "type": "text",
              "label": "Room ID",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "azimuthDeg",
              "type": "number",
              "label": "Compass azimuth (north 0°, east 90°)",
              "default": 180,
              "xs": 12,
              "sm": 6,
              "step": "any"
            },
            {
              "attr": "tiltDeg",
              "type": "number",
