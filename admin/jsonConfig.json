    "_Model": {
      "type": "panel",
      "label": "Forecast & thermal model",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "Open-Meteo GTI is fetched per facade. Forecast / sensor / position ages are minutes. Heating inputs are uncertain indicators, never measured room watts. The initial linear shading curve and thermal parameters need calibration. Check Open-Meteo usage terms for your deployment.",
          "sm": 12
        },
        "forecastRefreshMinutes": {
          "type": "number",
          "label": "Forecast Refresh Minutes",
          "default": 60,
          "xs": 12,
          "sm": 6
        },
        "forecastMaxAgeMinutes": {
          "type": "number",
          "label": "Forecast Max Age Minutes",
          "default": 180,
          "xs": 12,
          "sm": 6
        },
        "sensorMaxAgeMinutes": {
          "type": "number",
          "label": "Sensor Max Age Minutes",
          "default": 180,
          "xs": 12,
          "sm": 6
        },
        "positionMaxAgeMinutes": {
          "type": "number",
          "label": "Position Max Age Minutes",
          "default": 10080,
          "xs": 12,
          "sm": 6
        },
        "toleranceMaxC": {
