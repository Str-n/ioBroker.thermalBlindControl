    "_Model": {
      "type": "panel",
      "label": "Forecast & thermal model",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "Open-Meteo GTI is fetched per facade. Forecast / sensor / position ages are minutes. Heating inputs are uncertain indicators, never measured room watts. The initial linear shading curve and thermal parameters need calibration. Check Open-Meteo usage terms for your deployment.",
          "sm": 12
