{
  "type": "tabs",
  "i18n": false,
  "items": {
    "_General": {
      "type": "panel",
      "label": "General",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "Runtime switches under global.* and windows.* persist across restarts. Initial switches below are used only when their states are created. Start with dry run and shadow mode; active thermal control additionally requires global.dryRun=false and global.enabled=true. Only blind command IDs are written.",
          "sm": 12
        },
        "enabled": {
          "type": "checkbox",
          "label": "Initially enabled",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "dryRun": {
          "type": "checkbox",
          "label": "Dry run: never send motor commands",
          "default": true,
          "xs": 12,
          "sm": 6
        },
        "thermalMode": {
          "type": "select",
          "label": "Thermal control mode",
          "default": "shadow",
          "xs": 12,
          "sm": 6,
          "options": [
            {
              "label": "off",
              "value": "off"
            },
            {
              "label": "shadow",
              "value": "shadow"
            },
            {
              "label": "active",
              "value": "active"
            }
          ]
        },
        "disabledToday": {
          "type": "checkbox",
          "label": "Initially disabled today",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "vacationMode": {
          "type": "checkbox",
          "label": "Initially in vacation mode",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "latitude": {
          "type": "number",
          "label": "Latitude",
          "default": 50.47,
          "xs": 12,
          "sm": 6,
          "step": "any"
        },
        "longitude": {
          "type": "number",
          "label": "Longitude",
          "default": 7.47,
          "xs": 12,
          "sm": 6,
          "step": "any"
        },
        "timezone": {
          "type": "text",
          "label": "Building timezone (IANA)",
          "default": "Europe/Berlin",
          "xs": 12,
          "sm": 6
        },
        "startupDelaySeconds": {
          "type": "number",
          "label": "Startup Delay Seconds",
          "default": 30,
          "xs": 12,
          "sm": 6,
          "step": "any"
        },
        "optimizationIntervalMinutes": {
          "type": "number",
          "label": "Optimization Interval Minutes",
          "default": 15,
          "xs": 12,
          "sm": 6,
          "step": "any"
        },
        "minimumSolarPowerPerWindowW": {
          "type": "number",
          "label": "Minimum daylight per window (W)",
          "default": 0,
          "xs": 12,
          "sm": 6,
          "step": "any",
          "min": 0,
          "max": 10000,
          "help": "Reserve this much estimated unblocked solar power per window, even when the heat budget is exceeded. Limited by available sunlight. Zero disables the daylight minimum."
        },
        "minMovementIntervalMinutes": {
          "type": "number",
          "label": "Minimum time between automatic moves per blind (minutes)",
          "default": 15,
          "xs": 12,
          "sm": 6,
          "step": "any",
          "min": 15,
          "max": 1440,
          "help": "Applies to every automatic position change per blind, including morning and vacation schedules. 60 means at most one automatic move per hour. Thermal positions anticipate the full upcoming interval, including changes in solar exposure and daylight. The last-command timestamp survives restarts."
        },
        "minPositionChange": {
          "type": "number",
          "label": "Minimum automatic position change (percentage points)",
          "default": 10,
          "xs": 12,
          "sm": 6,
          "step": "any",
          "min": 1,
          "max": 100,
          "help": "Ignore automatic changes smaller than this absolute position difference. Default: 10 percentage points. With 10, 89 to 93 is ignored; 70 to 93 and a change of exactly 10 are allowed. Applies in both directions, including daylight corrections and scheduled moves. Manual controls remain available."
        }
      }
    },
    "_Rooms": {
      "type": "panel",
      "label": "Rooms & heating",
      "items": {
        "rooms": {
          "type": "accordion",
          "titleAttr": "name",
          "noDelete": false,
          "noAdd": false,
          "sm": 12,
          "items": [
            {
              "attr": "id",
              "type": "text",
              "label": "Stable ID (letters, numbers, _ or -)",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "name",
              "type": "text",
              "label": "Display name",
              "default": "",
              "xs": 12,
              "sm": 6
            },
            {
              "attr": "temperatureSensorId",
              "type": "objectId",
              "label": "Measured room temperature state (°C)",
              "default": "",
              "xs": 12,
              "sm": 12
            },
            {
              "attr": "targetTemperatureC",
